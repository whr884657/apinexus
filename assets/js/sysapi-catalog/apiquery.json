{
    "id": "apiquery",
    "name": "接口查询 API",
    "desc": "查前台可见接口：按 ID/名称/短码取详情、关键词搜索，或随机返回一条。不含上游机密。",
    "category": "接口查询",
    "methods": [
        "GET",
        "POST"
    ],
    "file": "apiquery.php",
    "params": [
        {
            "name": "key",
            "type": "string",
            "required": true,
            "description": "系统密钥。三态传钥：① Authorization: Bearer；② Header X-Api-Key / Api-Key / Apikey；③ Query ?key= / ?apikey=（GET 友好；生产优先 Header/Bearer）。亦可用 POST/JSON 的 key / apikey。在「系统设置 → 系统密钥」生成。",
            "example": "你的系统密钥"
        },
        {
            "name": "action",
            "type": "string",
            "required": false,
            "description": "操作类型（英文 action = 动作）。可选：get（按条件查一条详情）、search（关键词搜列表）、random（随机一条详情）。不传 action 且也不传 id/name/slug/q 时，默认等价于 random。",
            "example": "random"
        },
        {
            "name": "id",
            "type": "integer",
            "required": false,
            "description": "接口数字编号（英文 id = 标识）。正整数。用于 get：与 name、slug 三选一。也可不传 action，只传 id，系统会按 get 处理。",
            "example": "1"
        },
        {
            "name": "name",
            "type": "string",
            "required": false,
            "description": "接口名称（英文 name = 名称）。精确匹配数据库里的名称。用于 get，与 id、slug 三选一。",
            "example": "天气查询"
        },
        {
            "name": "slug",
            "type": "string",
            "required": false,
            "description": "代理短码（英文 slug / proxyslug = 短码）。一般是接口的调用短标识（如 apis 路径里那一段），不是数字 ID。也可写参数名 proxyslug。用于 get，与 id、name 三选一。",
            "example": "abc12"
        },
        {
            "name": "q",
            "type": "string",
            "required": false,
            "description": "搜索关键词（英文 q = query 查询词）。用于 search：模糊匹配名称、描述、分类。最长约 64 字；勿滥用通配符刷库。不传 action 只传 q 时按 search 处理。",
            "example": "天气"
        },
        {
            "name": "limit",
            "type": "integer",
            "required": false,
            "description": "返回条数上限（英文 limit = 限制）。仅 search 有效。整数 1～50，默认 20。",
            "example": "20"
        }
    ],
    "response": {
