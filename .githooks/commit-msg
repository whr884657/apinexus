#!/bin/sh
# 强制剥离 Cursor / AI 协助署名（commit-msg，最终关口）
MSG_FILE=$1
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

TMP_FILE="${MSG_FILE}.apinexus.strip"
if grep -Eiv \
  '^[[:space:]]*Co-authored-by:.*(Cursor|cursoragent|@cursor\.com)' \
  "$MSG_FILE" 2>/dev/null | \
  grep -Eiv \
  '^[[:space:]]*(Made[- ]with[- ]Cursor|Made-with:[[:space:]]*Cursor)' \
  > "$TMP_FILE" 2>/dev/null
then
  mv -f "$TMP_FILE" "$MSG_FILE"
elif [ -s "$TMP_FILE" ]; then
  mv -f "$TMP_FILE" "$MSG_FILE"
else
  rm -f "$TMP_FILE"
fi

# 若仍残留禁止字样 → 拒绝提交
if grep -Ei \
  'Co-authored-by:.*(Cursor|cursoragent|@cursor\.com)|Made[- ]with[- ]Cursor|Made-with:[[:space:]]*Cursor' \
  "$MSG_FILE" >/dev/null 2>&1
then
  echo "拒绝提交：提交说明含 Cursor/AI 署名。见 开发规范/Git提交禁止AI署名.md" >&2
  exit 1
fi

exit 0
